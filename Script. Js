// Data akun login
const USERS = {
  admin: {
    username: "Anggi",
    password: "54321",
    role: "Admin"
  },
  pelanggan: {
    username: "nasywa",
    password: "4321",
    role: "Pelanggan"
  }
};

// Element DOM
const loginForm = document.getElementById("login-form");
const usernameInput = document.getElementById("username");
const passwordInput = document.getElementById("password");
const errorMsg = document.getElementById("error-msg");

const loginContainer = document.getElementById("login-container");
const dashboardContainer = document.getElementById("dashboard-container");

const userGreeting = document.getElementById("user-greeting");
const userRoleBadge = document.getElementById("user-role-badge");
const adminContent = document.getElementById("admin-content");
const customerContent = document.getElementById("customer-content");
const logoutBtn = document.getElementById("logout-btn");

// Handle Submit Form Login
loginForm.addEventListener("submit", function (e) {
  e.preventDefault();

  const enteredUsername = usernameInput.value.trim();
  const enteredPassword = passwordInput.value.trim();

  // Validasi Admin
  if (
    enteredUsername === USERS.admin.username &&
    enteredPassword === USERS.admin.password
  ) {
    showDashboard(USERS.admin);
  }
  // Validasi Pelanggan
  else if (
    enteredUsername === USERS.pelanggan.username &&
    enteredPassword === USERS.pelanggan.password
  ) {
    showDashboard(USERS.pelanggan);
  }
  // Jika Salah
  else {
    errorMsg.textContent = "Username atau password salah!";
    errorMsg.style.display = "block";
  }
});

// Fungsi Menampilkan Dashboard
function showDashboard(user) {
  errorMsg.style.display = "none";
  loginContainer.classList.add("hidden");
  dashboardContainer.classList.remove("hidden");

  userGreeting.textContent = `Selamat datang, ${user.username}!`;
  userRoleBadge.textContent = user.role;

  if (user.role === "Admin") {
    adminContent.classList.remove("hidden");
    customerContent.classList.add("hidden");
  } else {
    customerContent.classList.remove("hidden");
    adminContent.classList.add("hidden");
  }
}

// Handle Logout
logoutBtn.addEventListener("click", function () {
  dashboardContainer.classList.add("hidden");
  loginContainer.classList.remove("hidden");

  // Reset Form
  usernameInput.value = "";
  passwordInput.value = "";
  errorMsg.style.display = "none";
});
